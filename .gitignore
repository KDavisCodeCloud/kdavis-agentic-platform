next-env.d.ts
# frontend/package-lock.json is deliberately tracked (2026-09-17,
# Kelvin's item 5, 24-gap-closure build) so `npm ci` is reproducible for
# CI and for anyone cloning this repo fresh -- it was blanket-ignored
# before, which is what made ci.yml's first real run fail. team-dashboard
# stays ignored; nobody asked to commit that one and empire-dashboard's
# lockfile was already tracked before this rule existed.
/team-dashboard/package-lock.json

# OS
.DS_Store
Thumbs.db

# Terraform state — contains secrets
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Kubernetes secrets
*-secret.yaml
*-secrets.yaml

# LLM audit log — stays local, not pushed
# (contains timing/usage data you may not want public)
# Comment this out if you want it tracked
knowledge/operator/llm-audit.md

