# Cloud Decoded — Environment Variable Template
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Supabase / Postgres ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Leads funnel (leads/capture/signup_handler.py, leads/integrations/slack.py) ──
SLACK_LEADS_WEBHOOK_URL=

# ── Platform health checks (core/health_check.py, weekly/monthly/quarterly-health-check.yml) ──
# Separate from SLACK_LEADS_WEBHOOK_URL above -- this is Kelvin's own ops
# channel for infra health alerts, not lead notifications. If unset, health
# sweeps still run and write their JSON report, they just have nowhere to alert to.
SLACK_OPS_WEBHOOK_URL=
# Only needed if the main backend's production URL ever differs from the
# default core/health_check.py already falls back to
# (https://kdavis-agentic-platform-production.up.railway.app).
MAIN_BACKEND_URL=

# ── Redis (LangGraph checkpointing) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...        # Dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=whsec_...     # Dashboard → Developers → Webhooks → signing secret

# Stripe Price IDs — create one monthly recurring price per tier in the Dashboard
# Dashboard → Products → Add product → add price → copy price_id (price_...)
STRIPE_PRICE_ID_STARTER=price_...   # $299/month
STRIPE_PRICE_ID_GROWTH=price_...    # $699/month
STRIPE_PRICE_ID_ENTERPRISE=price_... # $2,499/month

# ── Social publishing OAuth (Phase 2 — content pipeline) ─────────────────────
# LinkedIn: Dashboard → My Apps → create app → Auth tab → copy client ID/secret
# Required scopes: openid, profile, w_member_social
# TWO separate redirect URIs must both be registered on the LinkedIn app —
# missing the second one is what paused the internal flow on 2026-07-14:
#   Customer-facing (content.py):   {API_BASE_URL}/api/v1/content/connect/callback/linkedin
#   Internal/owner (internal_marketing.py): {API_BASE_URL}/api/v1/internal/marketing/connect/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Canva Connect API (internal marketing — image/design asset generation)
# developers.canva.com → create an "External Application" → Configuration tab
# Required scopes: asset:read asset:write design:content:read design:content:write
# Redirect URI to register: {API_BASE_URL}/api/v1/internal/marketing/connect/callback/canva
# Also requires: at least one Brand Template built in Canva's own UI with
# named autofill placeholder fields, and a Canva plan tier that includes
# Connect/Autofill API access — verify before relying on this integration.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# X (Twitter): developer.twitter.com → Projects & Apps → create app → Keys & Tokens
# Required scopes: tweet.write, users.read, offline.access  (OAuth 2.0 with PKCE)
# Redirect URI to register: {API_BASE_URL}/api/v1/content/connect/callback/x
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Default LLM keys (operator keys — used when workspace BYOK not configured)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ── Gemini image generation (assets_library/gemini_image_gen.py) ────────────
GEMINI_API_KEY=

# ── AWS (operator account — for provider abstraction layer) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Azure (operator account) ─────────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# ── Platform ──────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=

# ── Transactional email (core/email.py) ─────────────────────────────────────────
# Welcome email on checkout completion, Enterprise-tier alert to the owner.
# Unset RESEND_API_KEY = sends are skipped (logged), never fail the caller.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_ALERT_EMAIL=

# ── Email lifecycle system (migration 051 — core/marketing_email.py, core/email_scheduler.py) ──
# Marketing-stream sends (onboarding, dunning, winback, newsletter, etc.) use
# a different from-address than transactional above — Kelvin must verify
# SPF/DKIM for this subdomain in the Resend dashboard before any real send.
RESEND_MARKETING_FROM_EMAIL=
# HMAC key signing unsubscribe links AND click-tracking redirect links
# (core/unsubscribe_token.py, core/click_tracking.py). Required — every
# marketing send fails closed (refuses to send) without it. Generate:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CD_UNSUBSCRIBE_SECRET=
# Physical mailing address appended to every marketing email's compliance
# footer (CAN-SPAM requirement). Plain text, e.g. "THD Agentic Systems LLC,
# 123 Main St, City ST 00000".
CD_COMPLIANCE_MAILING_ADDRESS=
# Svix-compatible signing secret for Resend's bounce/complaint webhook
# (api/routes/email_public.py's /email/resend-webhook). Configure the
# webhook in the Resend dashboard pointed at
# {API_BASE_URL}/api/v1/email/resend-webhook, then paste its signing
# secret here (starts with whsec_).
RESEND_WEBHOOK_SECRET=
# Default quiet-hours timezone for marketing sends (06:00-18:00 local) --
# we don't know each recipient's real timezone, so this is a platform-wide
# default. See GAPS.md.
CD_EMAIL_QUIET_HOURS_TZ=America/Phoenix

# Fernet key for BYOK secret encryption at rest
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── FinOps / Compliance agent proxy (api/routes/finops_agent.py, compliance_agent.py) ──
# URLs of the separately-deployed Railway services this backend proxies to.
# Each workspace's tenant token for these services is stored encrypted
# (via ENCRYPTION_KEY above) in the workspaces table -- never sent to the
# frontend.
FINOPS_AGENT_API_URL=https://kdavis-finops-agent-production.up.railway.app
COMPLIANCE_AGENT_API_URL=https://kdavis-compliance-agent-production.up.railway.app

# ── Local dev ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Error monitoring (core/error_tracking.py) ───────────────────────────────
# Leave empty for local dev -- Sentry is skipped entirely, no account needed.
SENTRY_DSN=

# ── Obsidian vault sync (sop_agent → obsidian/vault_sync.py) ────────────────
# Local filesystem path to the vault root, e.g. /path/to/kdavis-agentic-platform/knowledge
OBSIDIAN_VAULT_PATH=

# ── Finance document storage (accounting_agent → finance/integrations/document_store.py) ──
# Local filesystem path for receipt/revenue-export files. LocalFileSystemStore
# only for now — S3Store exists for later, not wired in yet.
FINANCE_DOCUMENT_STORE_PATH=

# ── research_agent ────────────────────────────────────────────────────────────
# Set to "true" to enable live Reddit scraping; other sources are stubbed until built
ENABLE_LIVE_SCRAPING=false

# ── Brevo (email — replaces Systeme.io as of 2026-09-16) ───────────────────────
# leads/integrations/brevo_client.py. Contact tagging/segmentation is done via
# Brevo custom contact attributes (PRODUCT_ID, LEAD_STAGE), not per-stage tag
# IDs — nothing here needs a separate env var per lifecycle stage the way the
# old Systeme.io tag list did (those were never actually read by any code).
# Per-product Brevo automation (the actual "send the emails" step) is built
# once, by hand, per product, in the Brevo UI — see kdavis-microsaas-engine's
# BREVO_SETUP.md for the setup pattern this repo's Brevo integration mirrors.
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# ── Apollo ────────────────────────────────────────────────────────────────────
APOLLO_API_KEY=

# ── Marketing routes (api/routes/marketing.py) — leave empty in dev for no auth
MARKETING_API_KEY=
