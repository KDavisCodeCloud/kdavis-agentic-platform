NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MSE_API_URL=
NEXT_PUBLIC_API_URL=
# Server-only — never exposed to the browser. Shared secret the Cloud
# Decoded FastAPI backend expects on X-API-Key for /api/v1/marketing/*
# (api/routes/marketing.py's require_marketing_api_key). Used by
# app/api/linkedin-queue/generate/route.ts to call linkedin-on-demand.
MARKETING_API_KEY=

# Email Campaign HITL queue (app/dashboard/email-campaigns). The Cloud
# Decoded feed needs NO separate key here -- its backend
# (api/middleware/internal_auth.py) validates the signed-in admin's own
# Supabase session JWT directly, forwarded as-is by the proxy routes
# under app/api/email-campaigns/cloud-decoded/*, since ceo-dashboard and
# Cloud Decoded share the same Supabase project. Reuses NEXT_PUBLIC_API_URL
# above as the base URL.
#
# The MSE feed is a genuinely separate backend/Supabase project (mse-api)
# — its /marketing/internal/* routes are admin-JWT-gated, not
# MARKETING_API_KEY-gated (see that router's own docstring). ceo-dashboard
# signs its own short-lived admin JWT for this (lib/email-campaigns/mse-auth.ts)
# rather than forwarding a user session -- no new secret to mint. Copy the
# value of SUPABASE_JWT_SECRET already set on the mse-api Railway service
# (same value, just also present here) so both sides trust the same
# signature. Reuses NEXT_PUBLIC_MSE_API_URL above as the base URL.
MSE_SUPABASE_JWT_SECRET=

# Per-feed kill switches for the Email Campaign HITL queue, read
# server-side only in the app/api/email-campaigns/* proxy routes. Either
# feed degrades to a 503 on its own panel (never blanks the page) when
# its backend is unreachable regardless of this flag; this flag is for
# deliberately turning a feed off (e.g. mid-incident) without a deploy.
# Unset or any value other than "false" is treated as enabled.
EMAIL_CAMPAIGNS_CD_ENABLED=true
EMAIL_CAMPAIGNS_MSE_ENABLED=true
